<launch>
    <arg name="drone_id" value="0"/>
    <arg name="map_size_x" value="200.0"/>
    <arg name="map_size_y" value="200.0"/>
    <arg name="map_size_z" value=" 3.0"/>
    <arg name="init_x_" value="0"/>
    <arg name="init_y_" value="0"/>
    <arg name="init_z_" value="1"/>

    <arg name="use_sim" value="true"/>
    <arg name="odom_topic" value="ekf_fuser/odom" /> 
    <arg name="position_cmd" value="planning/position_cmd" />
    <arg name="cloud_topic" value="no_point_cloud" />
     
    <include file="$(find mockamap)/config/pcd_map_generate.xml" unless="$(arg use_sim)">
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="pcd_path" value="/home/nv/quzhou-project/data/small_scans.pcd"/>
    </include> 

    <!-- use simulator -->
    <include file="$(find so3_quadrotor_simulator)/config/simulator.xml" if="$(arg use_sim)">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="init_x_" value="$(arg init_x_)"/>
        <arg name="init_y_" value="$(arg init_y_)"/>
        <arg name="init_z_" value="$(arg init_z_)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)" />
        <arg name="position_cmd" value="$(arg position_cmd)" />
        <arg name="cloud_topic" value="$(arg cloud_topic)" />
    </include>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find so3_quadrotor_simulator)/rviz/single_drone_control.rviz" />
</launch>